<% content_for :head do %>
  <%= javascript_include_tag "recipes", type: "module" %>
<% end %>

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/recipes" data-nav="list">Recipes</a>
    <nav aria-label="Recipe navigation">
      <ul class="nav-list">
        <li><button type="button" data-action="random">Random</button></li>
        <li><a href="/recipes" data-nav="prev" hidden>Previous</a></li>
        <li><a href="/recipes" data-nav="next" hidden>Next</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="app" class="container">
  <p class="status" role="status">Loading recipes…</p>
</main>
